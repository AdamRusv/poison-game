[sub_resource type="Resource" id="Resource_te4kt"]
script = ExtResource("1_7puhk")
title = "TRAIT SHEET"
info = Array[String](["Fool: 
	Drinks from the cup that is in front of them

Sage:
	Drinks from the cup that is NOT in front of themselves


Tricky:
	Odd entries in Character Sheet are false

Deceptive:
	Even entries in Character Sheet are false
"])
metadata/_custom_type_script = "uid://csy0x4mgdxs00"

