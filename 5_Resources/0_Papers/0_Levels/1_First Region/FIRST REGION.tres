script = ExtResource("1_7puhk")
title = "Atlas -> Towerville"
info = Array[String](["Occupation:
- Blacksmiths are Lying about their age

- Rangers are Tricky

Race:
- Goblins are Deceptive

Additional Notes:
- Citizens that Lie about their Age are Sages

- Citizens that are Truthful about their Age are Fools
"])
