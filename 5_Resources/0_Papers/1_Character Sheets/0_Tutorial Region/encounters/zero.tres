[sub_resource type="Resource" id="Resource_11j1y"]
script = ExtResource("2_g2q5l")
dialogue = "The goal of this Game is to avoid drinking the Poison"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_lypjb"]
