[sub_resource type="Resource" id="Resource_6eb78"]
script = ExtResource("2_g2q5l")
dialogue = "Of course! As an elder, it is our duty to teach new players The Poison Game"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_fb3j3"]
script = ExtResource("2_g2q5l")
dialogue = "The goal of this Game is to avoid drinking the Poison"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_0hcow"]
script = ExtResource("2_g2q5l")
dialogue = "To achieve this goal, you must figure out which cup I will choose"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_g7yw3"]
script = ExtResource("2_g2q5l")
dialogue = "From there, you'll know where to put the Poison"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_xsf05"]
script = ExtResource("2_g2q5l")
dialogue = "Go ahead and grab the Poison. Since you are still learning, just place it into my cup"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

