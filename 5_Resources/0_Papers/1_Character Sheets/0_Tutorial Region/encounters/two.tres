[sub_resource type="Resource" id="Resource_b18gr"]
script = ExtResource("2_kd850")
dialogue = "Hello there!"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_rcssk"]
script = ExtResource("2_kd850")
dialogue = "We are now going to get into the \"meat\" of The Game"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_qby0y"]
script = ExtResource("2_kd850")
dialogue = "Against Poppy, you only had two Papers"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_3grnw"]
script = ExtResource("2_kd850")
dialogue = "Now, you have a third Paper called the Atlas"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_vs7tn"]
script = ExtResource("2_kd850")
dialogue = "Instead of connecting the Character Entries from the Character Sheet straight to the Trait Sheet..."
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_ngc2l"]
script = ExtResource("2_kd850")
dialogue = "You now connect the Entry from the Character Sheet to the Atlas"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_nvvxi"]
script = ExtResource("2_kd850")
dialogue = "Think of the Atlas being the middleman between them"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

[sub_resource type="Resource" id="Resource_s4fd8"]
script = ExtResource("2_kd850")
dialogue = "Good luck!"
metadata/_custom_type_script = "uid://fn2tb2dtu6fj"

